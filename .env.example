# Единственные две переменные, которые нужно ввести на бот-хосте.
# Всё остальное (база, курсы, ссылки, меню Telegram) создаётся автоматически.

# Токен бота от @BotFather
BOT_TOKEN=1234567890:AA...

# Ваш Telegram ID (узнать: @userinfobot)
ADMIN_ID=123456789

# Необязательно (есть разумные значения по умолчанию):
# PORT=8080
# PUBLIC_URL=https://ваш-домен.example
